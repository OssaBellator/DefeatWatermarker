{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/batch-index-v0.1.schema.json",
  "title": "DefeatWatermarker batch index v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "schema_version",
    "input_name",
    "recursive",
    "scan_only",
    "records"
  ],
  "properties": {
    "batch_id": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": "0.1"},
    "input_name": {"type": "string", "minLength": 1, "maxLength": 4096},
    "recursive": {"type": "boolean"},
    "scan_only": {"type": "boolean"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "media_type",
          "modality",
          "mode",
          "record_id",
          "error"
        ],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
          "modality": {
            "enum": ["image", "video", "audio", "text", "document", "binary", "unknown"]
          },
          "mode": {"enum": ["attack", "scan", "error"]},
          "record_id": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/sha256"}
            ]
          },
          "error": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1, "maxLength": 1024}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
