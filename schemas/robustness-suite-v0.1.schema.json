{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/robustness-suite-v0.1.schema.json",
  "title": "DefeatWatermarker robustness suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "version", "description", "scenarios"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "suite_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "description": {"type": "string", "maxLength": 4000},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "mutation_id",
          "modality",
          "transformation_family",
          "severity",
          "generation_count"
        ],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "mutation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "modality": {"enum": ["image", "video", "audio", "text", "document", "binary", "unknown"]},
          "transformation_family": {"type": "string", "minLength": 1, "maxLength": 128},
          "severity": {"type": "string", "minLength": 1, "maxLength": 64},
          "generation_count": {"type": "integer", "minimum": 1, "maximum": 16}
        }
      }
    }
  }
}
