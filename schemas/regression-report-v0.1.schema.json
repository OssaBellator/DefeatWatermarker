{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/regression-report-v0.1.schema.json",
  "title": "DefeatWatermarker robustness regression report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "baseline_id",
    "baseline_version",
    "baseline_digest",
    "current_evidence_id",
    "suite_match",
    "adapter_runtime_match",
    "metrics",
    "status",
    "reasons"
  ],
  "properties": {
    "report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "0.1"},
    "baseline_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "baseline_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "baseline_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_evidence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suite_match": {"type": "boolean"},
    "adapter_runtime_match": {"type": "boolean"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "baseline",
          "current",
          "max_drop",
          "observed_drop",
          "passed"
        ],
        "properties": {
          "metric": {
            "enum": [
              "survival_rate",
              "verification_survival_rate",
              "trust_survival_rate",
              "provenance_id_preservation_rate"
            ]
          },
          "baseline": {"type": "number", "minimum": 0, "maximum": 1},
          "current": {
            "oneOf": [
              {"type": "null"},
              {"type": "number", "minimum": 0, "maximum": 1}
            ]
          },
          "max_drop": {"type": "number", "minimum": 0, "maximum": 1},
          "observed_drop": {
            "oneOf": [
              {"type": "null"},
              {"type": "number", "minimum": -1, "maximum": 1}
            ]
          },
          "passed": {
            "oneOf": [
              {"type": "null"},
              {"type": "boolean"}
            ]
          }
        }
      }
    },
    "status": {"enum": ["pass", "fail", "indeterminate"]},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    }
  }
}
