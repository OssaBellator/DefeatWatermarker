{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/interoperability-matrix-v0.1.schema.json",
  "title": "DefeatWatermarker interoperability matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "version", "description", "adapter_ids", "cases"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "matrix_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "description": {"type": "string", "maxLength": 4000},
    "adapter_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "path", "media_type", "modality"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
          "modality": {"enum": ["image", "video", "audio", "text", "document", "binary", "unknown"]}
        }
      }
    }
  }
}
