{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/attack-plan-v0.1.schema.json",
  "title": "DefeatWatermarker anti-watermark attack plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_digest", "schema_version", "suite", "max_severity", "scenarios"],
  "properties": {
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "0.1"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "version", "digest"],
      "properties": {
        "suite_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "max_severity": {"enum": ["control", "low", "medium", "high"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "mutation_id",
          "modality",
          "transformation_family",
          "severity",
          "generation_count"
        ],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "mutation_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "modality": {
            "enum": ["image", "video", "audio", "text", "document", "binary", "unknown"]
          },
          "transformation_family": {"type": "string", "minLength": 1, "maxLength": 128},
          "severity": {"enum": ["control", "low", "medium", "high"]},
          "generation_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
