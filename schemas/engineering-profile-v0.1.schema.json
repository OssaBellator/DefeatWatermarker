{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/engineering-profile-v0.1.schema.json",
  "title": "DefeatWatermarker engineering profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "title",
    "applies_from",
    "scope_note",
    "required_modalities",
    "required_capabilities",
    "minimum_scenarios_per_modality",
    "source_references"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "applies_from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scope_note": {"type": "string", "minLength": 1, "maxLength": 4000},
    "required_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["image", "video", "audio", "text", "document", "binary", "unknown"]}
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
    },
    "minimum_scenarios_per_modality": {"type": "integer", "minimum": 1, "maximum": 64},
    "source_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    }
  }
}
