{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/DefeatWatermarker/schemas/reliability-report-v0.2.schema.json",
  "title": "DefeatWatermarker reliability report v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "corpus_id",
    "corpus_version",
    "corpus_digest",
    "adapter_id",
    "adapter_runtime",
    "cases",
    "summary"
  ],
  "properties": {
    "report_id": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": "0.2"},
    "corpus_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "corpus_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "corpus_digest": {"$ref": "#/$defs/sha256"},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_runtime": {"$ref": "#/$defs/runtime"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "artifact_sha256",
          "byte_length",
          "expected_detected",
          "actual_detected",
          "confidence",
          "verification_state"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "byte_length": {"type": "integer", "minimum": 0},
          "expected_detected": {"type": "boolean"},
          "actual_detected": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "verification_state": {"$ref": "#/$defs/verification_state"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "true_positive",
        "true_negative",
        "false_positive",
        "false_negative",
        "accuracy",
        "precision",
        "recall",
        "specificity",
        "false_positive_rate",
        "false_negative_rate"
      ],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "accuracy": {"$ref": "#/$defs/rate"},
        "precision": {"$ref": "#/$defs/nullable_rate"},
        "recall": {"$ref": "#/$defs/nullable_rate"},
        "specificity": {"$ref": "#/$defs/nullable_rate"},
        "false_positive_rate": {"$ref": "#/$defs/nullable_rate"},
        "false_negative_rate": {"$ref": "#/$defs/nullable_rate"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "nullable_rate": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/rate"}
      ]
    },
    "verification_state": {
      "enum": ["not_evaluated", "well_formed", "valid", "trusted", "invalid", "error"]
    }
  }
}
