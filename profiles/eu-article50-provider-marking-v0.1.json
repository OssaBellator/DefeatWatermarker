  "required_capabilities": [
    "evidence.content-addressed.v2",
    "evidence.offline-verifier.v1",
    "suite.detector-blind-fixed.v1",
    "metrics.detection-survival.v1",
    "interoperability.matrix.v1",
    "reliability.false-positive-negative.v1"
  ],
  "minimum_scenarios_per_modality": 1,
  "source_references": [
    "https://eur-lex.europa.eu/eli/reg/2024/1689/oj",
    "https://digital-strategy.ec.europa.eu/en/library/guidelines-transparency-obligations-providers-and-deployers-ai-systems",
    "https://digital-strategy.ec.europa.eu/en/policies/code-practice-ai-generated-content"
  ]
}
